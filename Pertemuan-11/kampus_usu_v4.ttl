@prefix ex: <https://contoh.github.io/web-semantik/251402095/kampus#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:alyh a foaf:Person ;
    foaf:name "Aliyah"@id ;
    ex:mengambil ex:web_semantik .

ex:budi a foaf:Person,
        ex:Lecturer,
        ex:Pegawai ;
    foaf:name "Budi Santoso"@id ;
    ex:mengajar ex:pbo .

ex:hadziq a foaf:Person ;
    foaf:name "Hadziq Naufal Sinaga"@id ;
    ex:mengambil ex:pbo,
        ex:web_semantik .

ex:ida a foaf:Person,
        ex:Lecturer,
        ex:Pegawai ;
    foaf:name "Ida Adi"@id ;
    ex:mengajar ex:mk_baru,
        ex:web_semantik .

ex:siti a foaf:Person,
        ex:Lecturer,
        ex:Pegawai ;
    foaf:name "Siti Rahmah"@id ;
    ex:mengajar ex:basis_data .

ex:basis_data a ex:Course ;
    foaf:name "Sistem Basis Data"@id ;
    ex:jumlahKredit 4 .

ex:mk_baru foaf:name "Pemrograman Web"@id .

ex:pbo a ex:Course ;
    foaf:name "Pemrograman Berorientasi Objek"@id ;
    ex:jumlahKredit 3 .

ex:Lecturer rdfs:subClassOf ex:Pegawai .

ex:web_semantik a ex:Course ;
    foaf:name "Web Semantik"@id ;
    ex:hariKuliah "Senin"@id ;
    ex:jumlahKredit 3 .

ex:Pegawai rdfs:subClassOf foaf:Person .

